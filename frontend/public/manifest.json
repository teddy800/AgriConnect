{
  "name": "AgriConnect - Agricultural Marketplace",
  "short_name": "AgriConnect",
  "description": "Connect with farmers and buyers across Ethiopia. Buy and sell agricultural produce directly.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#E9F3EE",
  "theme_color": "#1B7F3B",
  "orientation": "portrait-primary",
  "categories": ["agriculture", "marketplace", "business"],
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Marketplace",
      "short_name": "Market",
      "description": "Browse agricultural produce",
      "url": "/marketplace",
      "icons": [{ "src": "/icon-marketplace.png", "sizes": "96x96" }]
    },
    {
      "name": "Market Prices",
      "short_name": "Prices",
      "description": "View current market prices",
      "url": "/prices",
      "icons": [{ "src": "/icon-prices.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
