# AgriConnect Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriconnect
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_DIR=uploads

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ENABLED=false

# Email Configuration (Optional - for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=AgriConnect <noreply@agriconnect.et>

# Advanced Features
WEBSOCKET_ENABLED=true

# Redis (for caching and session management)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch (for advanced search)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External APIs (Optional)
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# SMS Service (Optional - for OTP verification)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+251900000000

# AWS S3 (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=agriconnect-uploads
S3_ENABLED=false

# Sentry (Optional - for error tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENABLED=false

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_PRICE_RECORDING=true
ENABLE_NOTIFICATIONS=true
ENABLE_TELEGRAM_BOT=false
