# Test Environment Variables
NODE_ENV=test
PORT=4001

# Test Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriconnect_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Test JWT
JWT_SECRET=test-jwt-secret-for-testing-only-not-for-production
JWT_EXPIRES_IN=1h

# Disable external services in tests
REDIS_ENABLED=false
TELEGRAM_ENABLED=false
SMTP_ENABLED=false
